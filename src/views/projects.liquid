---
permalink: "/{{ pages.sections.projecten.index.slug }}/"
---

{% assign projecten = pages.sections.projecten %}
{% layout './layouts/default-layout.liquid'
  , title: projecten.index.title.rendered 
  , current: projecten.index.slug %}

{% block head %}
  <link rel="stylesheet" href="/styles/display--form.css">
  <link rel="stylesheet" href="/styles/project--list.css">
  <link rel="stylesheet" href="/styles/components/masonry-list.css">
  <script src="/scripts/components/masonry-list.js" defer></script>
  <script src="/scripts/filter/projects.js" type="module"></script>
  <script src="/scripts/display--form.js" defer></script>
{% endblock %}

{% block %}
  <main class="grid-container" id="main">
    <div class="main-content">
      <section class="section--content" style="--delay: .1s">
        <h1>
          {{ projecten.index.title.rendered }}
        </h1>
      </section>

      <section class="section--content form--container" style="--delay: .15s">
        <form action="/{{projecten.index.slug}}">
          {% for taxonomy in pages.terms %}
            <details name="filter">
              <summary>{{ taxonomy[1].label }}</summary>
              {% for term in taxonomy[1].items %}
                <label>
                  <input
                    type="checkbox"
                    data-filter="{{ taxonomy[0] }}"
                    value="{{ term.slug }}">
                  {{ term.name }} ({{ term.count }})
                </label>
              {% endfor %}
            </details>
          {% endfor %}
        </form>
        {% render 'partials/components/organisms/Form/ViewSetter.liquid' %}
      </section>

      <section class="section--content" style="--delay: .2s">
        {{ projecten.items.size }}
        total

        {% if projecten.items.size < 1 %}
          <p>Nothing found</p>
        {% else %}
          {% assign colorPairs = projecten.items | noRepeatPairs: 2 %}

          {% render './partials/components/organisms/List/MasonryList.liquid'
            , projecten: projecten.items
            , colorPairs: colorPairs %}


          {% comment %} {% for project in projecten.items %}
                                                                                      <li
                                                                                        data-primary="{{ pair.primary }}"
                                                                                        data-secondary="{{ pair.secondary }}"
                                                                                        class="pattern-{{ pair.pattern }}">
                                                                                        <a href="/{{ projecten.index.slug }}/{{ project.slug }}">
                                                                                          {{ project.title.rendered }}
                                                                                        </a>
                                                                                      </li>
                                                                        {% endfor %} {% endcomment %}
        {% endif %}


        <template data-project-template>
          <li>
            <a data-permalink data-title></a>
          </li>
        </template>
      </section>
    </div>
  </main>
{% endblock %}